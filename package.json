    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/coverage-v8": "^3.1.4",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^15.5.18",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^3.1.4"
  }
