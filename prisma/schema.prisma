// This is your Prisma schema file for SQLite (default database)
// For PostgreSQL, use schema.postgresql.prisma
// For MongoDB, use the separate MongoDB client (src/lib/mongodb.ts)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  phone          String?   @unique
  hashedPassword String?
  role           Role      @default(STUDENT)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  avatar         String?
  bio            String?
  university     String?
  group          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastSessionInvalidation DateTime? // When all JWT tokens for this user should be considered invalid

  accounts       Account[]
  sessions       Session[]
  groups         UserGroup[]
  attempts       Attempt[]
  activityLogs   ActivityLog[]
  createdGroups  Group[]     @relation("CreatedGroups")
  createdDeadlines Deadline[] @relation("CreatedDeadlines")
  reminders        Reminder[]
  notificationPreferences String?  // JSON: {"email": true, "inApp": true}
  updatedSettings SystemSetting[] @relation("UpdatedSettings")
  createdAnnouncements Announcement[]
  gradesGiven     Grade[]    @relation("GradesGiven")
  gradesReceived  Grade[]    @relation("GradesReceived")
  favorites       FavoriteTask[]
  sentMessages    Message[]  @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  courseTemplates CourseTemplate[]
  exams          StudentExam[]
  customTasks    CustomTask[]

  @@index([role])
  @@index([deletedAt])
  @@index([university])
  @@index([isActive])
  @@index([emailVerified, isActive])
  @@index([role, isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
}

model VerificationCode {
  id        String   @id @default(cuid())
  code      String
  phone     String?
  email     String?
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([code])
  @@index([expires])
  @@index([phone])
  @@index([email])
}

model Group {
  id              String      @id @default(cuid())
  name            String
  description     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdByUserId String
  createdBy       User        @relation("CreatedGroups", fields: [createdByUserId], references: [id], onDelete: Cascade)
  members         UserGroup[]
  assignedTasks   GroupTask[]
  deadlines       Deadline[]
  announcements   Announcement[]
  templateAssignments TemplateAssignment[]

  @@index([createdByUserId])
}

model GroupTask {
  id        String   @id @default(cuid())
  groupId   String
  taskId    Int
  assignedAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, taskId])
  @@index([groupId])
  @@index([taskId])
}

model UserGroup {
  userId         String
  groupId        String
  assignedAt     DateTime  @default(now())
  assignedByUserId String?

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
  @@index([userId])
}

model Grade {
  id          String   @id @default(cuid())
  userId      String
  taskId      String
  score       Int      // Manual score 0-100
  comment     String?
  gradedById  String
  gradedAt    DateTime @default(now())

  user        User     @relation("GradesReceived", fields: [userId], references: [id], onDelete: Cascade)
  gradedBy    User     @relation("GradesGiven", fields: [gradedById], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
  @@index([taskId])
  @@index([gradedById])
}

model Attempt {
  id                    String   @id @default(cuid())
  userId                String
  taskId                String
  testCases             String   // JSON array of test cases
  score                 Int
  ecCoverage            Int
  bvCoverage            Int
  correctness           Int
  coveredEcIds          String   // JSON array of covered EC IDs
  coveredBvDescriptions String   // JSON array of covered BV descriptions
  timeSpent             Int      // seconds
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([userId, taskId])
  @@index([userId, taskId, createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?  // null for system operations (cron jobs)
  action    String   // e.g., "USER_CREATE", "ROLE_CHANGE", "GROUP_UPDATE"
  entity    String?  // e.g., "User", "Group", "Setting"
  entityId  String?
  details   String?  // JSON
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([action, userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // "RISK_THRESHOLD", "DEADLINE_APPROACHING", "SCHEDULED_REPORT", etc.
  severity  String   // "critical", "warning", "info"
  title     String
  message   String?
  entity    String?  // "student", "group", "task", "system"
  entityId  String?
  actionUrl String?
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([read])
  @@index([severity])
  @@index([createdAt])
  @@index([type])
  @@index([read, createdAt])
  @@index([severity, createdAt])
}

model SystemSetting {
  id               String   @id @default(cuid())
  key              String   @unique
  value            String   // JSON value
  updatedAt        DateTime @updatedAt
  updatedByUserId  String?
  updatedBy        User?    @relation("UpdatedSettings", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

model Deadline {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  type        String   // "EXAM", "TEST", "ASSIGNMENT", "COURSE_END", "REGISTRATION_END"
  groupId     String?  // null = system-wide
  taskId      Int?     // related task ID
  reminderSchedule String?  // JSON array of days before dueDate, e.g. "[7,3,1,0,-1]"
  createdAt   DateTime @default(now())
  createdBy   String
  creator     User     @relation("CreatedDeadlines", fields: [createdBy], references: [id], onDelete: Cascade)
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  reminders   Reminder[]

  @@index([dueDate])
  @@index([groupId])
  @@index([type])
  @@index([taskId])
  @@index([createdBy])
}

model Reminder {
  id         String   @id @default(cuid())
  deadlineId String
  userId     String
  offsetDays Int      @default(0)  // Days before dueDate (negative = overdue)
  sent       Boolean  @default(false)
  sentAt     DateTime?
  read       Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())

  deadline Deadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deadlineId])
  @@index([userId])
  @@index([sent])
  @@index([read])
  @@index([offsetDays])
  @@index([deadlineId, userId])
  @@index([deadlineId, sent, userId])
  @@index([userId, sent, read])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  groupId     String?  // null = system-wide (admin announcements)
  createdById String
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator     User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([createdById])
  @@index([createdAt])
  @@index([expiresAt])
}

model FavoriteTask {
  id        String   @id @default(cuid())
  userId    String
  taskId    Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
  @@index([taskId])
}

model Message {
  id          String   @id @default(cuid())
  fromUserId  String
  toUserId    String
  subject     String
  content     String
  read        Boolean  @default(false)
  readAt      DateTime?
  replyToId   String?
  createdAt   DateTime @default(now())

  fromUser    User     @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User     @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)
  replyTo     Message? @relation("MessageReplies", fields: [replyToId], references: [id])
  replies     Message[] @relation("MessageReplies")

  @@index([fromUserId])
  @@index([toUserId])
  @@index([toUserId, read])
  @@index([createdAt])
  @@index([replyToId])
  @@index([toUserId, createdAt])
  @@index([fromUserId, createdAt])
}

model CourseTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  taskIds     String   // JSON array of task IDs in recommended order
  topics      String?  // JSON array of topic tags
  estimatedHours Int?
  createdByUserId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  assignments  TemplateAssignment[]

  @@index([createdByUserId])
  @@index([name])
}

model TemplateAssignment {
  id          String   @id @default(cuid())
  templateId  String
  groupId     String
  assignedAt  DateTime @default(now())

  template    CourseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([templateId, groupId])
  @@index([templateId])
  @@index([groupId])
}

model StudentExam {
  id              String   @id @default(cuid())
  userId          String
  taskIds         String   // JSON array of task IDs
  timeLimit       Int      // seconds
  mode            String   // "exam" or "practice"
  avgScore        Int
  bestTaskId      Int?
  bestTaskScore   Int
  worstTaskId     Int?
  worstTaskScore  Int
  totalCorrectness Int
  timeSpent       Int      // seconds
  results         String   // JSON: per-task scores
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([userId, mode])
  @@index([userId, avgScore])
}

model CustomTask {
  id            String   @id @default(cuid())
  name          String
  difficulty    String   // "Легко", "Средне", "Сложно"
  signature     String
  description   String
  returnType    String
  topics        String   // JSON array of topic strings
  parameters    String   // JSON: [{name, type, description}]
  ecClasses     String   // JSON: [{className, ecLabel, description, exampleValues}]
  bvValues      String   // JSON: [{value, description}]
  code          String
  commonMistakes String?  // JSON array of strings
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([name])
}
