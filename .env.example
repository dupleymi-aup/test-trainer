# ============================================
# TestTrainer — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Database (SQLite by default)
DATABASE_URL="file:./dev.db"

# NextAuth
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-string"

# Email (SMTP) — optional in development (falls back to console logging)
# Required for production: password reset, email verification
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-password"
SMTP_FROM="TestTrainer <noreply@test-trainer.local>"

# NextAuth Email Provider (optional, used by next-auth for magic links)
EMAIL_SERVER=""
EMAIL_FROM="noreply@test-trainer.local"

# SMS (Twilio or other provider) — optional in development (falls back to console logging)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# Vercel Cron — for automated reminder sending
# Generate with: openssl rand -hex 32
CRON_SECRET="change-me"
