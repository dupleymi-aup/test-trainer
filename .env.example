# ============================================
# TestTrainer — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ============================================
# Database Configuration
# ============================================
# DB_TYPE: sqlite (default), postgres, or mongodb
# If not set, the system auto-detects based on available services:
#   - PostgreSQL on port 5432 → postgres
#   - MongoDB on port 27017 → mongodb
#   - Neither → sqlite (file-based, always available)

# Option 1: SQLite (default, file-based, no setup required)
DB_TYPE="sqlite"
DATABASE_URL="file:./dev.db"

# Option 2: PostgreSQL (uncomment and configure)
# DB_TYPE="postgres"
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/testtrainer?schema=public"

# Option 3: MongoDB (uncomment and configure)
# DB_TYPE="mongodb"
# MONGODB_URI="mongodb://127.0.0.1:27017/testtrainer"

# ============================================
# NextAuth
# ============================================
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-string"

# ============================================
# Email (SMTP) — optional in development (falls back to console logging)
# ============================================
# Required for production: password reset, email verification
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-password"
SMTP_FROM="TestTrainer <noreply@test-trainer.local>"

# NextAuth Email Provider (optional, used by next-auth for magic links)
EMAIL_SERVER=""
EMAIL_FROM="noreply@test-trainer.local"

# ============================================
# SMS (Twilio or other provider) — optional in development
# ============================================
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# ============================================
# Logging
# ============================================
# LOG_LEVEL: error (default), warn, info, debug, silent
LOG_LEVEL="error"

# NODE_ENV: development (default), production, test
NODE_ENV="development"

# ============================================
# Vercel Cron — for automated reminder sending
# ============================================
# Generate with: openssl rand -hex 32
CRON_SECRET="change-me"
